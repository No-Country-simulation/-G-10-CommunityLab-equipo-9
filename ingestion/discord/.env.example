# Plantilla de configuración. Cópiala como .env (Git ignora .env) y completa los valores.
# Nunca subas el .env al repo ni compartas su contenido.

# Developer Portal → tu aplicación → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Los muestra verify_connection.py
DISCORD_GUILD_ID=
DISCORD_CHANNEL_DUDAS_ID=
DISCORD_CHANNEL_LOGROS_ID=

# Editar canal → Integraciones → Webhooks → Copiar URL del webhook
DISCORD_WEBHOOK_DUDAS_URL=
DISCORD_WEBHOOK_LOGROS_URL=

# Roles de Discord que cuentan como mentor o staff (autor.rol del contrato).
# Ajustes del servidor → Roles → clic derecho en el rol → Copiar ID del rol
# (requiere el Modo desarrollador). Si son varios, sepáralos con comas.
DISCORD_MENTOR_ROLE_IDS=
DISCORD_STAFF_ROLE_IDS=

# Solo para la simulación: los webhooks no tienen roles, así que los mentores
# simulados se reconocen por su autor.id (sim- + nombre). Separados por comas.
SIMULATED_MENTORS=sim-andres-mentor

# Puerta de la API Java que recibe los lotes (send_batch.py). Con docker compose es
# el puerto 8008 de esta máquina. Vacía: solo funciona send_batch.py --prueba.
BACKEND_INGEST_URL=http://127.0.0.1:8008/api/v1/lotes

# Clave para la cabecera X-Api-Key (la misma que API_KEY_INGESTA del .env de la raíz).
# No se escribe a mano: desde la raíz del repositorio, python scripts/generar_api_key.py
BACKEND_API_KEY=

# Días que se releen en cada extracción para captar reacciones y ediciones nuevas.
INGEST_REREAD_DAYS=7
