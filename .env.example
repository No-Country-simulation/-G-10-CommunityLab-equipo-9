# Variables para docker compose (raíz del repositorio).
# Copiar este archivo como .env y completarlo. El .env NUNCA se sube a git.
# Cada servicio recibe solo las variables que necesita (ver compose.yml).

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=insightedu
POSTGRES_USER=insightedu
# Obligatoria: inventar una contraseña larga. Solo la usan la base y la API Java.
POSTGRES_PASSWORD=

# --- API Java: claves de los clientes (S1, cabecera X-Api-Key) ---
# No se escribe a mano: python scripts/generar_api_key.py la crea y la copia en ingestion/discord/.env
# Vacía: la API Java rechaza todo con 401, salvo /actuator/health.
API_KEY_INGESTA=
# S2: la clave entre la API Java y la IA (Java la envía, la IA la exige en /v1/procesar).
# No se escribe a mano: python scripts/generar_api_key.py --cliente ia
# Vacía: la IA rechaza /v1/procesar con 401 y los mensajes quedan PENDIENTE.
API_KEY_IA=
# T05: la clave del bot para POST /api/v1/mensajes/en-vivo (solo esa puerta).
# No se escribe a mano: python scripts/generar_api_key.py --cliente bot
# Vacía: Java rechaza al bot con 401 y el bot no responde nada.
API_KEY_BOT=
# T07: la clave del panel para /api/v1/borradores y /api/v1/errores (solo esas puertas).
# No se escribe a mano: python scripts/generar_api_key.py --cliente panel
# Vacía: el panel muestra un aviso y no puede leer nada.
API_KEY_PANEL=

# --- Panel de curaduría (T07) ---
# Los usuarios del panel y los hashes de sus contraseñas (nunca las contraseñas).
# No se escribe a mano: python scripts/crear_usuario_panel.py (pide la contraseña sin mostrarla).
# Vacía: nadie puede entrar al panel.
PANEL_USUARIOS=

# --- Bot de Discord (T05) ---
# Los mismos nombres y valores que en ingestion/discord/.env: copiar esas líneas de allá.
# ⚠️ Un solo bot encendido con este token (docs/OPERACION.md §7).
DISCORD_BOT_TOKEN=
# Los dos únicos canales que escucha el bot
DISCORD_CHANNEL_DUDAS_ID=
DISCORD_CHANNEL_LOGROS_ID=
# Para reconocer a los alumnos simulados (webhooks) y a los mentores igual que el lote de la hora
DISCORD_WEBHOOK_DUDAS_URL=
DISCORD_WEBHOOK_LOGROS_URL=
DISCORD_MENTOR_ROLE_IDS=
DISCORD_STAFF_ROLE_IDS=
SIMULATED_MENTORS=sim-andres-mentor

# --- OCI Object Storage ---
# URL PAR nueva, solo de escritura (nunca la que quedó en el historial de git).
# Vacía: la API Java arranca igual, pero no puede subir a OCI.
OCI_PAR_URL=

# --- IA (D5: un solo proveedor, Google Gemini) ---
# Clave de Google AI Studio. Vacía: el clasificador usa palabras clave y el Agente FAQ no responde.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# google: clasifica con Gemini · keyword: clasifica por palabras clave, sin gastar llamadas (pruebas)
ORQ_CLASIFICADOR_PROVIDER=google
# T06 · Agente-Mod: el modelo de Gemini que redacta los posts y casos de éxito (DEC-85).
# Vacío: el mismo de GEMINI_MODEL.
MOD_MODEL_NAME=
# T06: false apaga la generación automática de borradores (cada logro nuevo gasta una llamada a Gemini).
GENERACION_HABILITADA=true
# T06b · FAQ semanal (cada lunes a las 8:00, hora de Bogotá). true: se arma también una vez al encender Java,
# para la demo; gasta unas 15 a 20 llamadas a Gemini. Nunca se arman dos FAQ de la misma semana.
FAQ_SEMANAL_AL_ARRANCAR=false
# Cuántos días hacia atrás se juntan las dudas.
FAQ_SEMANAL_DIAS=7
